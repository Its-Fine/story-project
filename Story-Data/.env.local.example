# Local development only. Do not use these credentials in production.
POSTGRES_DB=story_db
POSTGRES_USER=story_user
POSTGRES_PASSWORD=local_story_password
STORY_MIGRATION_DB_PASSWORD=local_migration_password
STORY_AUTH_DB_PASSWORD=local_auth_password
STORY_BACK_DB_PASSWORD=local_back_password
STORY_ADMIN_DB_PASSWORD=local_admin_service_password

# Keycloak local stand only. Replace these values outside a private workstation.
KEYCLOAK_DB_PASSWORD=local_keycloak_password
KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=local_keycloak_admin_password

MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=local_minio_password
MINIO_MC_BUCKET=story

# Base64 for a local 32-byte key. Generate a different value for shared environments.
STORY_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
STORY_JWT_EXPIRATION_ACCESS=15m
STORY_JWT_EXPIRATION_REFRESH=1d

STORY_COOKIE_SECURE=false
STORY_COOKIE_SAME_SITE=Lax
STORY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstrap operations are disabled during normal restarts.
STORY_BOOTSTRAP_ADMIN_ENABLED=false
STORY_ADMIN_USERNAME=
STORY_ADMIN_PASSWORD=
STORY_BOOTSTRAP_CONTESTS_ENABLED=false
STORY_FLYWAY_BASELINE_ON_MIGRATE=false

STORY_WORK_SIZE=20MB
STORY_APPLICATION_SIZE=20MB
