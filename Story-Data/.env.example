# --------------------------------------------------------------------
# Story — production environment template
# Copy this file to .env and fill every required value before starting Compose.
# For local-only examples, use .env.local.example instead.
# --------------------------------------------------------------------

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Fixed database roles: story_migrator, story_auth, story_back.
# Every role must have a different generated password.
STORY_MIGRATION_DB_PASSWORD=
STORY_AUTH_DB_PASSWORD=
STORY_BACK_DB_PASSWORD=
STORY_ADMIN_DB_PASSWORD=

# ---------------------------------------------------------
# Minio
# ---------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_MC_BUCKET=

# ---------------------------------------------------------
# Spring (both story-back and story-auth)
# ---------------------------------------------------------
STORY_BOOTSTRAP_ADMIN_ENABLED=false
STORY_ADMIN_USERNAME=
STORY_ADMIN_PASSWORD=
# Optional bootstrap profile (used only when creating a new admin).
STORY_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
STORY_BOOTSTRAP_ADMIN_LAST_NAME=User
STORY_BOOTSTRAP_ADMIN_BIRTH_DATE=2001-11-04

# Run contest seed only as an explicit one-off operation, then set back to false.
STORY_BOOTSTRAP_CONTESTS_ENABLED=false

# Keep false during normal startup. Existing databases require an explicit,
# verified one-time baseline procedure described in docs/database-migrations.md.
STORY_FLYWAY_BASELINE_ON_MIGRATE=false

# JWT secret must be Base64-encoded and at least 32 bytes long
# Generate with: openssl rand -base64 32
# Or PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random})|%{[byte]$_})
STORY_JWT_SECRET=
STORY_JWT_EXPIRATION_ACCESS=15m
STORY_JWT_EXPIRATION_REFRESH=1d

# Production must use HTTPS. SameSite=None is accepted only with Secure=true.
STORY_COOKIE_SECURE=true
STORY_COOKIE_SAME_SITE=Lax

# Exact comma-separated browser origins; wildcards are not accepted with credentials.
STORY_CORS_ALLOWED_ORIGINS=https://example.com

# ---------------------------------------------------------
# File size limits
# ---------------------------------------------------------
# Valid upload MIME types, comma-separated.
STORY_WORK_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/jpg,image/tiff

# Host ports; container ports remain unchanged.
STORY_POSTGRES_HOST_PORT=5432
STORY_MINIO_API_HOST_PORT=9000
STORY_MINIO_CONSOLE_HOST_PORT=9001
STORY_FRONTEND_HOST_PORT=3000

STORY_WORK_SIZE=20MB
STORY_APPLICATION_SIZE=20MB
