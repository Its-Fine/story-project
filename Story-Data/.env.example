# --------------------------------------------------------------------
# Story — environment variables for local development / Docker
# Copy this file to .env and adjust values.
# --------------------------------------------------------------------

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=story_db
POSTGRES_USER=story_user
POSTGRES_PASSWORD=story_password

# ---------------------------------------------------------
# Minio
# ---------------------------------------------------------
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_MC_BUCKET=story

# ---------------------------------------------------------
# Spring (both story-back and story-auth)
# ---------------------------------------------------------
STORY_ADMIN_USERNAME=admin@example.com
STORY_ADMIN_PASSWORD=admin_password

# JWT secret must be Base64-encoded and at least 32 bytes long
STORY_JWT_SECRET=your-base64-encoded-secret-at-least-32-chars-long
STORY_JWT_EXPIRATION_ACCESS=15m
STORY_JWT_EXPIRATION_REFRESH=1d

# Cookie: set to 'true' for production (https), 'false' for localhost (http)
STORY_COOKIE_SECURE=false

# ---------------------------------------------------------
# File size limits
# ---------------------------------------------------------
STORY_WORK_SIZE=20MB
STORY_APPLICATION_SIZE=20MB

# ---------------------------------------------------------
# Feature flags
# ---------------------------------------------------------
STORY_CLOSED=false
